# Single-GPU overrides for OSCAR eval scripts. Upstream defaults assume 4-GPU
# TP=4 production.
#
# This file is sourced directly by reproduction/scripts/_common.sh (`set -a;
# source run_config.env`), so exactly ONE MEM_FRAC / MAX_RUNNING /
# CUDA_GRAPH_MAX_BS assignment can be active at a time -- whichever is
# uncommented below wins. The two hardware blocks are kept side by side for
# reference; switching cards means commenting one block and uncommenting the
# other, not deleting either.

# --- ACTIVE: RTX 4090, 24GB, sm89 -------------------------------------------
# These are the WORKING, validated values -- see ENVIRONMENT.md section 5.
MEM_FRAC=0.72
# Paper-knee KV windows (defaults, stated explicitly for the record):
SGLANG_MIXED_KV_PREFIX_TOKENS=64
SGLANG_MIXED_KV_RECENT_TOKENS=256

# --- REFERENCE (not active): larger card for the benchmark run -------------
# Decided 2026-08-15: renting an A100 40GB or H100 80GB for the full GPQA
# benchmark run instead of the 4090. These are STARTING POINTS, not derived --
# unlike the 4090 block above, none of these three values has been validated
# against real hardware. Expect to adjust on first contact with the pod. To
# activate: comment out the RTX 4090 block above and uncomment these three
# lines (KV window settings are model/method properties, not hardware -- they
# stay the same regardless of card).
#
# MEM_FRAC=0.8              # back toward eval_oscar_gpqa.sh:38's own default,
#                            # since a 40-80GB card removes the memory pressure
#                            # that forced 0.72 on the 4090
# MAX_RUNNING=64             # upstream's own 4-GPU default (eval_oscar_gpqa.sh:39);
#                            # a starting point for one larger GPU, not re-derived
# CUDA_GRAPH_MAX_BS=32       # upstream's own 4-GPU default (eval_oscar_gpqa.sh:40);
#                            # same caveat
